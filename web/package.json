{
  "name": "luz-certa",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "tsc -p tsconfig.engine.json && tsc -p scripts/tsconfig.json && node --test \"scripts/**/*.test.mts\" && ng test --watch=false",
    "fixtures": "node scripts/generate-fixtures.mts",
    "e2e": "playwright test --project=chromium",
    "catalogue:check": "node scripts/catalogue/catalogue-cli.mts check",
    "catalogue:build": "node scripts/catalogue/catalogue-cli.mts build",
    "design:shots": "node scripts/design-shots.mts",
    "evidence": "playwright test --project=evidence"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "fflate": "0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "yaml": "2.9.1"
  },
  "overrides": {
    "piscina": "5.3.2"
  }
}
